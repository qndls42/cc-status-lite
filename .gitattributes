# Shell scripts must always check out with LF. With core.autocrlf=true on
# Windows a clone would rewrite them to CRLF and execution breaks with
# "bad interpreter: /bin/sh^M".
*.sh text eol=lf

# The test fixtures are compared byte for byte, so their line endings must not
# depend on the platform they were checked out on.
tests/cases/** text eol=lf

# PowerShell reads LF fine; pinning it keeps both implementations identical in
# the diff.
*.ps1 text eol=lf
